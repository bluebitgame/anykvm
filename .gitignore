# Local system metadata
.DS_Store
._*

# Local future optimization plans and design notes
/docs/plans/

# Build output and caches
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
__pycache__/
*.py[cod]
*.exe
*.test
*.out
*.uf2
*.hex
*.elf
*.map
*.o
*.a
*.bin
*.spv
/anykvm
/cmd/anykvm/anykvm

# Generated shader assets and local benchmark records
/internal/gpuconv/shaders/*.json
/internal/jpegcodec/shaders/*.json
/tools/codec-bench/**/results*.json

# Pinned third-party inputs restored by tools/prepare_sources.py
/internal/**/third_party/**
!/internal/**/third_party/**/
/internal/wsmedia/web/vendor/*
/internal/gamestream/coverlogos/*
!/internal/gamestream/coverlogos/logos.json
/internal/gamestream/coverfonts/

# Synthetic media generated by tools/generate_test_media.py
/internal/testdata/*
!/internal/testdata/README.md

# Local runtime configuration and generated TLS certificates
config.yaml
cert.pem
key.pem
state.json
.env
.env.*
!.env.example

# Downloaded runtime dependencies
ffmpeg
lib/
platform-tools/
scrcpy-server*
